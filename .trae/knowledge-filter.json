{
  "version": "1.0",
  "description": "知识沉淀候选的两层过滤规则 MVP",
  "layer1_blacklist": {
    "skip_extensions": [".md", ".json", ".css", ".scss", ".html", ".txt"],
    "min_total_lines": 5,
    "skip_patterns": [
      "颜色", "字体", "间距", "文案", "按钮", "样式", "margin", "padding", "color", "font",
      "console.log", "debugger", "注释", "format", "lint", "prettier",
      "typo", "拼写", "rename",
      "README", "CHANGELOG"
    ]
  },
  "layer2_whitelist": {
    "tags": [
      {
        "name": "SSE",
        "patterns": ["SSE", "EventSource", "AbortController", "stream", "buffer", "chunk"],
        "weight": 1.0
      },
      {
        "name": "异步错误",
        "patterns": ["async", "try-catch", "Promise", "await", "reject", "catch"],
        "weight": 0.7
      },
      {
        "name": "架构分层",
        "patterns": ["架构", "分层", "composables", "views", "api", "controller", "依赖方向"],
        "weight": 0.9
      },
      {
        "name": "性能",
        "patterns": ["性能", "优化", "缓存", "泄露", "卡顿", "超时", "内存", "节流", "防抖", "懒加载"],
        "weight": 0.9
      },
      {
        "name": "安全",
        "patterns": ["安全", "XSS", "SQL", "注入", "权限", "鉴权", "token", "输入校验"],
        "weight": 0.9
      },
      {
        "name": "数据一致性",
        "patterns": ["数据丢失", "JSON 解析", "同步", "状态不一致", "竞态", "buffer"],
        "weight": 0.8
      },
      {
        "name": "跨主题",
        "patterns": ["暗黑模式", "dark", "亮色模式", "响应式", "移动端适配"],
        "weight": 0.6
      },
      {
        "name": "反复问题",
        "patterns": ["反复", "多次", "又", "再次", "总是", "还是"],
        "weight": 0.5
      }
    ],
    "auto_commit_threshold": 2.0,
    "pending_threshold": 0.8
  }
}
