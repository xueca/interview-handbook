ks found.","line":74,"column":37,"messageId":"unexpectedAfterClosingBracket","endLine":74,"endColumn":37,"fix":{"range":[2255,2255],"text":"\n"}},{"ruleId":"vue/singleline-html-element-content-newline","severity":1,"message":"Expected 1 line break before closing tag (`</div>`), but no line breaks found.","line":74,"column":75,"messageId":"unexpectedBeforeOpeningBracket","endLine":74,"endColumn":75,"fix":{"range":[2293,2293],"text":"\n"}},{"ruleId":"vue/singleline-html-element-content-newline","severity":1,"message":"Expected 1 line break after opening tag (`<div>`), but no line breaks found.","line":75,"column":40,"messageId":"unexpectedAfterClosingBracket","endLine":75,"endColumn":40,"fix":{"range":[2339,2339],"text":"\n"}},{"ruleId":"vue/singleline-html-element-content-newline","severity":1,"message":"Expected 1 line break before closing tag (`</div>`), but no line breaks found.","line":75,"column":57,"messageId":"unexpectedBeforeOpeningBracket","endLine":75,"endColumn":57,"fix":{"range":[2356,2356],"text":"\n"}},{"ruleId":"vue/attributes-order","severity":1,"message":"Attribute \":disabled\" should go before \"@keyup.enter\".","line":86,"column":9,"messageId":"expectedOrder","endLine":86,"endColumn":28,"fix":{"range":[2537,2590],"text":":disabled=\"loading\"\n        @keyup.enter=\"handleSend\""}},{"ruleId":"vue/attributes-order","severity":1,"message":"Attribute \"style\" should go before \"@keyup.enter\".","line":87,"column":9,"messageId":"expectedOrder","endLine":87,"endColumn":24,"fix":{"range":[2537,2614],"text":"style=\"flex: 1\"\n        @keyup.enter=\"handleSend\"\n        :disabled=\"loading\""}},{"ruleId":"vue/max-attributes-per-line","severity":1,"message":"':loading' should be on a new line.","line":89,"column":33,"messageId":"shouldBeOnNewLine","endLine":89,"endColumn":51,"fix":{"range":[2655,2656],"text":"\n"}},{"ruleId":"vue/max-attributes-per-line","severity":1,"message":"'@click' should be on a new line.","line":89,"column":52,"messageId":"shouldBeOnNewLine","endLine":89,"endColumn":71},{"ruleId":"vue/singleline-html-element-content-newline","severity":1,"message":"Expected 1 line break after opening tag (`<el-button>`), but no line breaks found.","line":89,"column":72,"messageId":"unexpectedAfterClosingBracket","endLine":89,"endColumn":72,"fix":{"range":[2695,2695],"text":"\n"}},{"ruleId":"vue/singleline-html-element-content-newline","severity":1,"message":"Expected 1 line break before closing tag (`</el-button>`), but no line breaks found.","line":89,"column":74,"messageId":"unexpectedBeforeOpeningBracket","endLine":89,"endColumn":74,"fix":{"range":[2697,2697],"text":"\n"}}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":34,"fixableErrorCount":0,"fixableWarningCount":24,"source":"<!-- AI对话页: 消息列表+输入框+快捷出题 → useAiChat() -->\n<script setup>\nimport { ref, nextTick, watch } from 'vue'\nimport { useAiChat } from '../composables/useAiChat'\nimport { ElMessage } from 'element-plus'\n\nconst { messages, loading, error, sendMessage, generateQuestions, stop } = useAiChat()\n\nconst inputValue = ref('')\nconst messagesRef = ref(null)\n\n// 快捷出题选项\nconst quickCategory = ref('JavaScript')\nconst quickDifficulty = ref('medium')\nconst categories = ['JavaScript', 'Vue', 'CSS', '网络', '工程化']\nconst difficulties = [\n  { label: '简单', value: 'easy' },\n  { label: '中等', value: 'medium' },\n  { label: '困难', value: 'hard' }\n]\n\n// 发送消息\nfunction handleSend() {\n  if (!inputValue.value.trim()) return\n  sendMessage(inputValue.value)\n  inputValue.value = ''\n}\n\n// 快捷出题\nfunction handleQuickGenerate() {\n  generateQuestions({ category: quickCategory.value, difficulty: quickDifficulty.value })\n}\n\n// 消息列表自动滚动到底部\nwatch(messages, () => {\n  nextTick(() => {\n    if (messagesRef.value) {\n      messagesRef.value.scrollTop = messagesRef.value.scrollHeight\n    }\n  })\n}, { deep: true })\n\n// 错误提示\nwatch(error, (val) => {\n  if (val) ElMessage.error(val)\n})\n</script>\n\n<template>\n  <div class=\"ai-chat\">\n    <h2>AI 面试助手</h2>\n\n    <!-- 快捷出题区 -->\n    <el-card shadow=\"hover\" class=\"quick-section\">\n      <div class=\"quick-row\">\n        <el-select v-model=\"quickCategory\" placeholder=\"选择分类\" style=\"width: 140px\">\n          <el-option v-for=\"c in categories\" :key=\"c\" :label=\"c\" :value=\"c\" />\n        </el-select>\n        <el-select v-model=\"quickDifficulty\" placeholder=\"选择难度\" style=\"width: 100px\">\n          <el-option v-for=\"d in difficulties\" :key=\"d.value\" :label=\"d.label\" :value=\"d.value\" />\n        </el-select>\n        <el-button type=\"primary\" :loading=\"loading\" @click=\"handleQuickGenerate\">快捷出题</el-button>\n        <el-button v-if=\"loading\" type=\"danger\" @click=\"stop\">停止</el-button>\n      </div>\n    </el-card>\n\n    <!-- 消息列表 -->\n    <el-card shadow=\"hover\" class=\"messages-card\">\n      <div ref=\"messagesRef\" class=\"messages-list\">\n        <div v-if=\"messages.length === 0\" class=\"empty-tip\">\n          开始和AI对话吧！可以提问技术问题，或使用快捷出题功能。\n        </div>\n        <div v-for=\"(msg, i) in messages\" :key=\"i\" :class=\"['message', msg.role]\">\n          <div class=\"message-role\">{{ msg.role === 'user' ? '我' : 'AI' }}</div>\n          <div class=\"message-content\">{{ msg.content }}</div>\n        </div>\n      </div>\n    </el-card>\n\n    <!-- 输入区 -->\n    <div class=\"input-row\">\n      <el-input\n        v-model=\"inputValue\"\n        placeholder=\"输入你的问题...\"\n        @keyup.enter=\"handleSend\"\n        :disabled=\"loading\"\n        style=\"flex: 1\"\n      />\n      <el-button type=\"primary\" :loading=\"loading\" @click=\"handleSend\">发送</el-button>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.ai-chat { max-width: 900px; margin: 0 auto; }\n.ai-chat h2 { margin: 0 0 16px 0; font-size: 20px; color: #303133; }\n.quick-section { margin-bottom: 16px; }\n.quick-row { display: flex; gap: 12px; align-items: center; }\n.messages-card { margin-bottom: 16px; }\n.messages-list { height: 400px; overflow-y: auto; padding: 8px; }\n.empty-tip { text-align: center; color: #909399; padding: 60px 0; font-size: 14px; }\n.message { margin-bottom: 12px; padding: 10px 12px; border-radius: 8px; }\n.message.user { background: #ecf5ff; margin-left: 40px; }\n.message.assistant { background: #f4f4f5; margin-right: 40px; }\n.message-role { font-size: 12px; color: #909399; margin-bottom: 4px; }\n.message-content { font-size: 14px; color: #303133; line-height: 1.6; white-space: pre-wrap; }\n.input-row { display: flex; gap: 12px; }\n</style>\n","usedDeprecatedRules":[{"ruleId":"quotes","replacedBy":["@stylistic/quotes"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"11.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"quotes","url":"https://eslint.style/rules/quotes"}}]}},{"ruleId":"semi","replacedBy":["@stylistic/semi"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"11.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"semi","url":"https://eslint.style/rules/semi"}}]}}]}]